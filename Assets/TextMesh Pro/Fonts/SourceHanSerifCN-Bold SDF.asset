    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 7
    characterSequence: "\u6536\u96C6\u53A8\u623F\u63D0\u793A\u5361\u52A8\u5F39\u4E0D\u5F97\uFF0C\u6211\u597D\u50CF\u88AB\u9053\u5177\u63CF\u8FF0\u5C01\u5370\u5728\u8FD9\u6536\u96C6\u53A8\u623F\u63D0\u793A\u5361\r\n\u6321\u4F4F\u5149\u7EBF\uFF0C\u5E2E\u52A9\u5C0F\u523A\u732C\u5728\u5F71\u5B50\u4E2D\u524D\u884C\u3002\r\n\u8BA9\u5899\u4E0A\u7684\u5F71\u5B50\u53D8\u6210\u9636\u68AF\u7684\u5F62\u72B6\u3002\u5F20\u684C\u5B50\u524D\u9762\u4E86\u3002\u72D0\u72F8\uFF0C\u4F60\u9192\u5566\uFF1F\u4ECA\u5929\u4E0D\u662F\u6709\u732B\u8BBE\u8BA1\u5E08\u7684\u65B0\u54C1\u53D1\u5E03\u4F1A\u5417\uFF0C\u6211\u4EE5\u4E3A\u4F60\u4F1A\u5F88\u5FD9\u3002\u6211\u52A8\u4E0D\u4E86\uFF0C\u6211\u5FC5\u5DF2\u6536\u5165\u9053\u5177\u7BB1 
      \u6309\u201CX\u201D\u67E5\u770B\u987B\u5F97\u79BB\u5F00\u8FD9\u91CC\u3002\u4F60\u7761\u7740\u524D\uFF0C\u597D\u50CF\u8981\u5E26\u4E0A\u6258\u76D8\u53BB\u53A8\u623F\u627E\u72EE\u5B50\u5988\u5988\u3002\u9053\u5177\u7C7B\u578B\u9053\u5177\u540D\u79F0\u9053\u5177\u63CF\u8FF0\u9053\u5177\u63CF\u8FF02\u5DF2\u6536\u5165\u9053\u5177\u7BB1 
      \u6309\u201CX\u201D\u67E5\u770B\u54E6\u5BF9\u4E86\uFF0C\u53A8\u623F\u63D0\u793A\u5361\u2026\u2026\u53EF\u662F\u684C\u4E0A\u6CA1\u6709\u66F4\u591A\u7684\u5361\u7247\u4E86\uFF0C\u6211\u8BE5\u600E\u4E48\u529E\uFF1F\u6211\u4E2A\u5B50\u5C0F\uFF0C\u80FD\u53BB\u4F60\u53BB\u4E0D\u4E86\u7684\u5730\u65B9\uFF0C\u4E5F\u80FD\u770B\u5230\u4F60\u770B\u4E0D\u5230\u7684\u4E1C\u897F\u3002\u8BA9\u6211\u6765\u5E2E\u4F60\u5427\u3002\u4E0D\u884C\uFF0C\u5149\u592A\u4EAE\u4E86\u3002\u6211\u53EA\u80FD\u8D70\u5728\u5F71\u5B50\u91CC\u3002\u5C0F\u72D0\u72F8\uFF0C\u5E2E\u6211\u6321\u4F4F\u706F\u5149\u3002\u592A\u68D2\u4E86\uFF01\u8FD9\u6837\u662F\u4E0D\u662F\u5C31\u884C\u4E86\uFF1F\u5982\u679C\u662F\u62FF\u7ED9\u72EE\u5B50\u5988\u5988\u7684\u8BDD\uFF0C\u6211\u8FD8\u6709\u4E00\u4EF6\u793C\u7269\u60F3\u62FF\u7ED9\u5979\uFF0C\u6700\u9002\u5408\u6446\u5230\u5C31\u9910\u533A\u4E86\u3002\u554A\u2026\u2026\u5728\u5899\u4E0A\uFF0C\u5C0F\u523A\u732C\u4F60\u80FD\u5E2E\u5E2E\u6211\u5417\uFF1F\u597D\u5440\uFF0C\u662F\u4EC0\u4E48\uFF1F\u662F\u5F88\u591A\u5E74\u524D\u72EE\u5B50\u5988\u5988\u7684\u53A8\u827A\u5956\u7AE0\u3002\u554A\u2026\u2026\u5B83\u5728\u5899\u4E0A\uFF0C\u5C0F\u523A\u732C\u4F60\u80FD\u5E2E\u5E2E\u6211\u5417\uFF1F\u6211\u4E0A\u4E0D\u53BB\u554A\u2026\u2026\u4F46\u662F\u4E5F\u8BB8\u53EF\u4EE5\u501F\u52A9\u5F71\u5B50\u7684\u9B54\u6CD5\u3002\u4EC0\u4E48\u662F\u5F71\u5B50\u7684\u9B54\u6CD5\uFF1F\u628A\u5F71\u5B50\u6295\u5C04\u5230\u5899\u9762\u4E0A\u540E\uFF0C\u4F1A\u53EC\u5524\u51FA\u6765\u5E76\u4E0D\u5B58\u5728\u7684\u4E8B\u7269\u2026\u2026\u4F60\u8BD5\u8BD5\u7528\u4E66\uFF0C\u642D\u6210\u53F0\u9636\uFF1F\u5BF9\uFF0C\u5C31\u662F\u8FD9\u6837\uFF01\u6709\u4E86\u5F71\u5B50\u53EC\u5524\u51FA\u7684\u53F0\u9636\uFF0C\u6211\u5C31\u4E0D\u7528\u518D\u5BB3\u6015\u706F\u5149\u4E86\u3002\u7A7A\u95F4\u5728\u6D41\u8F6C\uFF0C\u5FEB\u62FF\u8D77\u6258\u76D8\uFF01\r\n"
